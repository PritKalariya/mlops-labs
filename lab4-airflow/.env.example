# Copy to .env (gitignored) and fill every empty value. See README, Prerequisites, for how.

# Host user id. Run `id -u` and put the result here. Must own ./logs ./data ./model.
AIRFLOW_UID=1000
# Host port for the API server and UI. Only bound on 127.0.0.1. Change it if 8080 is taken.
AIRFLOW_PORT=8080

# Postgres metadata database.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=
POSTGRES_DB=airflow

# Airflow secrets. Each service must see the same values.
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__API__SECRET_KEY=

# Admin user, created by airflow-init. Used for the UI login and the REST API token.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=

# Email alerts (optional). Leave both unset and alerts go to the task log only.
# ALERT_TO=you@gmail.com
# AIRFLOW_CONN_SMTP_GMAIL='{"conn_type":"smtp","host":"smtp.gmail.com","port":587,"login":"you@gmail.com","password":"xxxxxxxxxxxxxxxx","extra":{"disable_ssl":true,"from_email":"you@gmail.com"}}'
