# Optional. Defaults load model 1.0.0 from ../model/1.0.0/model.pkl.
# To override, export these in your shell before starting uvicorn.

# Expected model version; must match the version in metadata.json
IRIS_ARTIFACT_VERSION=1.0.0

# Location of model.pkl. Supported scheme: file:// (gs:// is not implemented)
# Spaces in the path must be encoded as %20
IRIS_ARTIFACT_URI=file:///absolute/path/to/lab2-fastapi/model/1.0.0/model.pkl
