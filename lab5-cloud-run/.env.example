# Non-secret tunables for the deploy tool. Copy to .env; .env is gitignored.
# The project, region, repo, service and service account are fixed in deploy/config.py.

# Gate: p95 latency limit in ms, measured from this machine through the internet.
# Set to 2x the p95 measured on v1 (70.6 ms), rounded up to the next 10 ms (see docs/results.md).
GATE_P95_MS=150

# Gate load run: requests and concurrency.
GATE_REQUESTS=200
GATE_CONCURRENCY=5

# Canary: requests sent to the service URL while 10% of traffic is on the new revision.
CANARY_REQUESTS=100
