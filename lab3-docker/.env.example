# Host port for the api service. Change it if 8000 is taken on your machine.
HOST_PORT=8000

# Optional. The image bakes the model in and the Compose file already defaults
# these to the baked-in path, so you only set them to point somewhere else.
# IRIS_ARTIFACT_URI=file:///app/model/1.0.0/model.pkl
# IRIS_ARTIFACT_VERSION=1.0.0
